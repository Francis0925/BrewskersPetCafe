# Copy this file to .env and fill in your own values. Never commit .env.

# Required outside of local testing. Use a long random string, for example:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# "development" (default) or "production". Production turns on secure cookies
# and refuses to start with the default secret key.
APP_ENV=development

# Leave false on any shared or public machine.
FLASK_DEBUG=false

# Only needed for the forgot-password email. Use a Gmail app password,
# not your normal Gmail password.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Optional. Defaults to petcoffeeshop.db and backups/ in this folder.
# DATABASE_PATH=
# BACKUP_DIR=
